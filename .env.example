# OpenRouter — required for the conversational agent

OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# SQLite for local Windows runs; docker-compose overrides this to Postgres
DATABASE_URL=sqlite:///./portfly.db

# Bound conversation history sent to the model
MAX_HISTORY_MESSAGES=16

# Business desk: shared secret for /desk and the conversation/dashboard endpoints.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty and those endpoints refuse all requests.
DESK_TOKEN=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
